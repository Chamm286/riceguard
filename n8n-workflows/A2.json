{
  "name": "A2 | SQL Injection Detector",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "detect-sql-injection", "responseMode": "lastNode", "options": {} },
      "id": "webhook-a2",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 300],
      "webhookId": "detect-sql-injection"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "alert_id", "value": "={{ $json.body.id }}", "type": "number" },
            { "id": "a2", "name": "title", "value": "={{ $json.body.title }}", "type": "string" },
            { "id": "a3", "name": "severity", "value": "={{ $json.body.severity }}", "type": "string" },
            { "id": "a4", "name": "category", "value": "={{ $json.body.category }}", "type": "string" },
            { "id": "a5", "name": "ip_address", "value": "={{ $json.body.ip_address }}", "type": "string" },
            { "id": "a6", "name": "status", "value": "={{ $json.body.status }}", "type": "string" },
            { "id": "a7", "name": "description", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "a8", "name": "created_at", "value": "={{ $json.body.created_at }}", "type": "string" },
            { "id": "a9", "name": "detector", "value": "A2-SQLInjection", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-a2",
      "name": "Normalize Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose" },
          "conditions": [
            { "id": "cond-a2", "leftValue": "={{ $json.category }}", "rightValue": "sql_injection", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-a2",
      "name": "Is SQL Injection?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "15muXUMvQg2cPRNM2lN7bCIJf_13DEQfsmz_oe-K3Rbk", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Alerts", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.alert_id }}",
            "title": "={{ $json.title }}",
            "severity": "={{ $json.severity }}",
            "category": "={{ $json.category }}",
            "ip_address": "={{ $json.ip_address }}",
            "status": "={{ $json.status }}",
            "description": "={{ $json.description }}",
            "created_at": "={{ $json.created_at }}"
          },
          "matchingColumns": ["id"],
          "schema": []
        },
        "options": {}
      },
      "id": "sheets-a2",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 200],
      "credentials": { "googleApi": { "id": "REPLACE", "name": "Google Service Account account" } }
    },
    {
      "parameters": {
        "chatId": "7893336271",
        "text": "=🚨 *SQL INJECTION DETECTED*\n\n🆔 Alert #{{ $json.alert_id }}\n📌 {{ $json.title }}\n⚠️ Mức độ: *{{ $json.severity.toUpperCase() }}*\n🎯 IP: `{{ $json.ip_address }}`\n📝 {{ $json.description }}\n\n⏰ {{ $json.created_at }}\n🛡️ Detector: {{ $json.detector }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-a2",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, 200],
      "credentials": { "telegramApi": { "id": "REPLACE", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alerts SET status = 'processing', resolution_note = 'Auto-processed by A2' WHERE id = {{ $('Normalize Data').item.json.alert_id }};",
        "options": {}
      },
      "id": "db-a2",
      "name": "Update DB Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [760, 300],
      "credentials": { "postgres": { "id": "REPLACE", "name": "Postgres account" } },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Normalize Data", "type": "main", "index": 0 }]] },
    "Normalize Data": { "main": [[{ "node": "Is SQL Injection?", "type": "main", "index": 0 }]] },
    "Is SQL Injection?": { "main": [
      [{ "node": "Save to Google Sheets", "type": "main", "index": 0 }],
      []
    ]},
    "Save to Google Sheets": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] },
    "Notify Telegram": { "main": [[{ "node": "Update DB Status", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
