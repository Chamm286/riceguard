    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"needs_alert\": true,\n  \"severity\": \"medium\",\n  \"reason\": \"Cảm biến đã mất tín hiệu hơn 30 phút; cần kiểm tra nguồn điện, kết nối mạng và gateway.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -528,
        320
      ],
      "id": "0e2fea71-9ca6-40a8-ac6e-7bbfd7cf20d9",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const OFFLINE_THRESHOLD_MINUTES = 30;\nconst items = $input.all();\nconst now = Date.now();\n\nreturn items.flatMap((item, index) => {\n  const s = item.json;\n  // Ignore incomplete records safely; no timestamp means offline duration cannot be trusted.\n  if (s.id == null || !s.sensor_code || !s.last_seen_at) return [];\n  const lastSeen = new Date(s.last_seen_at).getTime();\n  if (!Number.isFinite(lastSeen) || lastSeen > now) return [];\n\n  const minutesAgo = Math.max(0, (now - lastSeen) / 60000);\n  if (minutesAgo <= OFFLINE_THRESHOLD_MINUTES) return [];\n\n  return [{\n    json: { ...s, minutes_ago: Number(minutesAgo.toFixed(2)), offline_threshold_minutes: OFFLINE_THRESHOLD_MINUTES },\n    pairedItem: { item: index }\n  }];\n});"
      },
