{
  "name": "A1 | SSH Brute Force Detector",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "detect-ssh",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-a1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 300],
      "webhookId": "detect-ssh"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "alert_id", "value": "={{ $json.body.id }}", "type": "number" },
            { "id": "a2", "name": "title", "value": "={{ $json.body.title }}", "type": "string" },
            { "id": "a3", "name": "severity", "value": "={{ $json.body.severity }}", "type": "string" },
            { "id": "a4", "name": "category", "value": "={{ $json.body.category }}", "type": "string" },
            { "id": "a5", "name": "ip_address", "value": "={{ $json.body.ip_address }}", "type": "string" },
            { "id": "a6", "name": "status", "value": "={{ $json.body.status }}", "type": "string" },
            { "id": "a7", "name": "description", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "a8", "name": "created_at", "value": "={{ $json.body.created_at }}", "type": "string" },
            { "id": "a9", "name": "detector", "value": "A1-SSH-BruteForce", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-a1",
      "name": "Normalize Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-a1",
              "leftValue": "={{ $json.category }}",
              "rightValue": "brute_force",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-a1",
      "name": "Is Brute Force?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "15muXUMvQg2cPRNM2lN7bCIJf_13DEQfsmz_oe-K3Rbk", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Alerts", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.alert_id }}",
            "title": "={{ $json.title }}",
            "severity": "={{ $json.severity }}",
            "category": "={{ $json.category }}",
            "ip_address": "={{ $json.ip_address }}",
            "status": "={{ $json.status }}",
            "description": "={{ $json.description }}",
            "created_at": "={{ $json.created_at }}"
          },
          "matchingColumns": ["id"],
          "schema": []
        },
        "options": {}
      },
      "id": "sheets-a1",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 200],
      "credentials": { "googleApi": { "id": "REPLACE", "name": "Google Service Account account" } }
    },
    {
      "parameters": {
        "chatId": "7893336271",
        "text": "=🚨 *PHÁT HIỆN SSH BRUTE FORCE*\n\n🆔 Alert #{{ $json.alert_id }}\n📌 {{ $json.title }}\n⚠️ Mức độ: *{{ $json.severity.toUpperCase() }}*\n🎯 IP: `{{ $json.ip_address }}`\n📝 {{ $json.description }}\n\n⏰ {{ $json.created_at }}\n🛡️ Detector: {{ $json.detector }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-a1",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, 200],
      "credentials": { "telegramApi": { "id": "REPLACE", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/firewall/block",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ip\": \"{{ $json.ip_address }}\",\n  \"reason\": \"SSH Brute Force alert #{{ $json.alert_id }}\",\n  \"duration\": 3600\n}",
        "options": { "timeout": 5000, "ignoreResponseCode": true }
      },
      "id": "block-a1",
      "name": "Auto Block IP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alerts SET status = 'processing', resolution_note = 'Auto-processed by A1' WHERE id = {{ $json.alert_id }};",
        "options": {}
      },
      "id": "db-a1",
      "name": "Update DB Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [760, 300],
      "credentials": { "postgres": { "id": "REPLACE", "name": "Postgres RiceGuard" } },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Normalize Data", "type": "main", "index": 0 }]]
    },
    "Normalize Data": {
      "main": [[{ "node": "Is Brute Force?", "type": "main", "index": 0 }]]
    },
    "Is Brute Force?": {
      "main": [
        [
          { "node": "Save to Google Sheets", "type": "main", "index": 0 },
          { "node": "Auto Block IP", "type": "main", "index": 0 }
        ],
        []
      ]
    },
    "Save to Google Sheets": {
      "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]]
    },
    "Notify Telegram": {
      "main": [[{ "node": "Update DB Status", "type": "main", "index": 0 }]]
    },
    "Auto Block IP": {
      "main": [[{ "node": "Update DB Status", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
