{
  "name": "MASTER SECURITY SOAR",
  "nodes": [
    {
      "parameters": {
        "content": "## 1. TIẾP NHẬN DỮ LIỆU\nWebhook nhận báo cáo từ Agri Report",
        "height": 250,
        "width": 250,
        "color": 5
      },
      "id": "note1",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agri-report",
        "options": {}
      },
      "id": "webhook1",
      "name": "1. Webhook - Agri Report",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [-350, 50],
      "webhookId": "agri-report"
    },
    {
      "parameters": {
        "content": "## 2. TIỀN XỬ LÝ\nLàm sạch dữ liệu và bảo mật",
        "height": 250,
        "width": 250,
        "color": 6
      },
      "id": "note2",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-100, -200]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n// Giả lập làm sạch dữ liệu\nreturn {\n  image_url: data.image_url || 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Rice_plant.jpg/640px-Rice_plant.jpg', // Link ảnh mẫu nếu không có\n  report_id: data.report_id || 'unknown'\n};"
      },
      "id": "code_clean",
      "name": "2. Extract & Sanitize Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 50]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.image_url }}",
              "rightValue": ".php",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if_secure",
      "name": "3. File Security Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [150, 50]
    },
    {
      "parameters": {
        "content": "## 3. PHÂN TÍCH AI\nTải ảnh và phân tích bằng Gemini",
        "height": 250,
        "width": 300,
        "color": 4
      },
      "id": "note3",
      "name": "Note 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [450, -200]
    },
    {
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "http_download",
      "name": "4. Download Rice Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 50]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:5000/api/ai/analyze",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image",
              "value": "={{ $binary.data }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http_ai",
      "name": "5. Gemini Vision AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 50]
    },
    {
      "parameters": {
        "content": "## 4. LƯU TRỮ & CẢNH BÁO\nLưu DB, gửi Telegram, realtime",
        "height": 250,
        "width": 300,
        "color": 3
      },
      "id": "note4",
      "name": "Note 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1000, -200]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:5000/api/n8n/sync",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "result",
              "value": "={{ $json }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http_sync",
      "name": "7. PostgreSQL Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 50]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "🚨 CẢNH BÁO BỆNH LÚA\nKết quả phân tích: {{ $('5. Gemini Vision AI').item.json.diagnosis }}\nMức độ: {{ $('5. Gemini Vision AI').item.json.severity }}",
        "additionalFields": {}
      },
      "id": "telegram1",
      "name": "10. Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1250, 50]
    }
  ],
  "connections": {
    "1. Webhook - Agri Report": {
      "main": [
        [
          {
            "node": "2. Extract & Sanitize Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Extract & Sanitize Data": {
      "main": [
        [
          {
            "node": "3. File Security Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. File Security Check": {
      "main": [
        [
          {
            "node": "4. Download Rice Image",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "4. Download Rice Image": {
      "main": [
        [
          {
            "node": "5. Gemini Vision AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. Gemini Vision AI": {
      "main": [
        [
          {
            "node": "7. PostgreSQL Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "7. PostgreSQL Sync": {
      "main": [
        [
          {
            "node": "10. Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
