      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  s.id, s.sensor_code, s.sensor_type, s.field_id, s.last_seen_at, s.status,\n  f.region,\n  CASE WHEN s.last_seen_at IS NOT NULL\n       THEN EXTRACT(EPOCH FROM (NOW() - s.last_seen_at)) / 60\n       ELSE NULL END AS minutes_ago\nFROM iot_sensors s\nLEFT JOIN fields f ON f.id = s.field_id\nWHERE s.status IN ('active', 'offline')",
        "options": {}
