      "id": "aa7823c3-4e73-4cdb-97ab-5d38d145e257",
      "name": "IF - Needs Alert?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  EXISTS (\n    SELECT 1 FROM alerts\n    WHERE alert_type = 'IOT_OFFLINE'\n      AND status = 'new'\n      AND metadata->>'sensor_id' = $1\n  ) AS exists,\n  (\n    SELECT id FROM alerts\n    WHERE alert_type = 'IOT_OFFLINE'\n      AND status = 'new'\n      AND metadata->>'sensor_id' = $1\n    ORDER BY created_at DESC\n    LIMIT 1\n  ) AS alert_id",
        "options": {
          "queryReplacement": "={{ String($('Validate & Filter Offline Sensors').item.json.id) }}"
        }
      },
