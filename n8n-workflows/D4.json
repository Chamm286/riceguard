            {
              "id": "c3479442-9653-407b-b19e-e5e91f38bf86",
              "leftValue": "={{ $json.output.needs_alert === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
