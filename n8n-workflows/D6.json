    {
      "parameters": {
        "jsCode": "// ===== 1. LẤY DỮ LIỆU TỪ WEBHOOK =====\nconst body = $('Webhook').first().json.body;\nconst msg = (body.message || '').toLowerCase();\nconst messageId = $input.first().json.id;\n\n// ===== 2. DANH SÁCH TỪ KHÓA FAQ =====\nconst faqKeywords = [\n  'vàng lá', 'đạo ôn', 'đốm nâu', 'phân bón', 'tưới nước',\n  'sâu', 'rầy', 'bệnh', 'thuốc', 'bón', 'nước', 'lúa',\n  'nấm', 'khô', 'héo', 'vàng', 'xanh', 'đốm', 'cháy',\n  'thời tiết', 'mưa', 'nắng', 'hạn', 'ngập'\n];\n\n// ===== 3. KIỂM TRA SPAM =====\nconst isSpam = msg.length < 5;\n\n// ===== 4. KIỂM TRA KHẨN CẤP =====\nconst urgentKeywords = ['khẩn cấp', 'gấp', 'ngay', 'hỏa tốc', 'cứu'];\nconst isUrgent = urgentKeywords.some(k => msg.includes(k));\n\n// ===== 5. KIỂM TRA KHỚP FAQ =====\nconst matchedFaq = faqKeywords.filter(k => msg.includes(k));\n\n// ===== 6. QUYẾT ĐỊNH CẦN ADMIN HAY KHÔNG =====\nlet needsAdmin;\nlet reason;\n\nif (isSpam) {\n  needsAdmin = false;\n  reason = 'Spam - quá ngắn';\n} else if (isUrgent) {\n  needsAdmin = true;\n  reason = 'Khẩn cấp - cần admin xử lý ngay';\n} else if (matchedFaq.length === 0) {\n  needsAdmin = true;\n  reason = 'Không khớp FAQ';\n} else {\n  needsAdmin = false;\n  reason = `Khớp FAQ: ${matchedFaq.join(', ')}`;\n}\n\n// ===== 7. TRẢ VỀ KẾT QUẢ =====\nreturn [{\n  json: {\n    message_id: messageId,\n    farmer_id: body.farmer_id,\n    conversation_id: body.conversation_id || 'conv-auto',\n    message: body.message,\n    needs_admin: needsAdmin,\n    classify_reason: reason,\n    matched_keywords: matchedFaq,\n    is_urgent: isUrgent,\n    is_spam: isSpam\n  }\n}];"
      },
