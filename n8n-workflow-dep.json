            "node": "📤 Trả kết quả về BE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📤 Trả kết quả về BE": {
      "main": [
        [
          {
            "node": "⚠️ Mức độ HIGH?",
            "type": "main",
            "index": 0
          }
        ]
